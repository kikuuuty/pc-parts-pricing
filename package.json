{
  "name": "pc-parts-pricing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "dev:gateway": "tsx scripts/dev-gateway.ts",
    "dev:gateway:rpc": "tsx scripts/dev-gateway.ts --rpc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test",
    "db:migrate": "wrangler d1 migrations apply pc-parts-pricing --local",
    "db:migrate:remote": "wrangler d1 migrations apply pc-parts-pricing --remote",
    "build": "wrangler deploy --dry-run --outdir dist",
    "validate:gateway": "tsx scripts/check-gateway-config.ts",
    "build:gateway": "npm run validate:gateway && wrangler deploy --config wrangler.gateway.production.jsonc --dry-run --outdir dist/gateway",
    "build:gateway:initial": "npm run validate:gateway && wrangler deploy --config wrangler.gateway.jsonc --dry-run --outdir dist/gateway-initial",
    "deploy": "wrangler deploy",
    "deploy:gateway": "npm run validate:gateway && wrangler deploy --config wrangler.gateway.production.jsonc",
    "smoke:yahoo": "tsx scripts/smoke-yahoo.ts",
    "smoke:pricing": "tsx scripts/smoke-pricing.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260926.1",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.1",
    "miniflare": "5.20260925.0-alpha",
    "tsx": "4.23.15",
    "typescript": "~5.9.3",
    "wrangler": "4.141.0"
  }
}
